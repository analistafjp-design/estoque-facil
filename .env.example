# Copie este arquivo para .env e preencha os valores antes de rodar a
# aplicação. Nenhuma credencial real deve ir para o .env.example nem para
# o controle de versão — só o .env local (git-ignorado) tem os valores
# de verdade. Ver ARCHITECTURE.md para o que cada bloco significa.

APP_NAME="Estoque Fácil PRO"
APP_ENV=local
# Gerar com: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Em produção, "error" ou "warning" — "debug" não deve vazar stack trace
# nem detalhe de query para quem só precisa saber que algo deu errado.
LOG_LEVEL=debug

# Banco de dados — MySQL é o alvo da spec. Precisa existir antes da
# primeira migration (`php artisan migrate`); o app não cria o database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=estoque_facil
DB_USERNAME=estoque_facil
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Mailer — como os convites (item 5 da spec) são enviados por e-mail.
# 'log' escreve a mensagem em storage/logs/laravel.log, sem enviar nada de
# verdade: use em dev. Em produção, troque para 'smtp' e preencha
# MAIL_HOST/PORT/USERNAME/PASSWORD com as credenciais do provedor de
# e-mail transacional (ex.: um SMTP de terceiro) — nunca hardcoded no
# código, sempre por aqui.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="naoresponda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
